      "pointer": "/evidence/15",
      "sha256": "0f55556ef5307a5c4e42fccaac91863024e2a8faf64add3905c10bb544854448",
      "value_sha256": "e0e30d37be698c006e3edd7b3c066bc2588a07175e958af025d67bc6f4c5b269",
      "locator": "research/dual-b6/southeast-outer.json/evidence/15",
      "url": null,
      "excerpt": "{\"constraints\":[{\"basis\":\"direct\",\"object\":\"li_xiaoyi\",\"relation\":\"east_of\",\"subject\":\"market_small\"}],\"drawing\":\"既有小市点击锚点保留，类型用开放的市场符号；旁图标路侧未明，不画市场围墙、摊位数或新增街道。\",\"ellipsis_is_editorial\":false,\"entities\":[\"market_small\",\"li_xiaoyi\",\"road_qingyang\"],\"geographic_coordinates\":null,\"id\":\"EO16\",\"limit\":\"主图把小市排在道路北侧属于既有显示安排，不是新增的正文结论；不能以小寺误字新增寺院。\",\"non_entailment_constraints\":[{\"basis\":\"not_established\",\"object\":\"road_qingyang\",\"relation\":\"north_of\",\"subject\":\"market_small\"}],\"non_entailments\":[\"洛阳小市在清阳御道北\",\"小市与孝义里中心同纬\",\"小市距青阳门三里\"],\"quote\":\"孝義里東，即是洛陽小市。\",\"quote_is_excerpt\":true,\"quote_locator\":\"卷二·景宁寺条后洛阳小市段；Z2 p0132a10；F2小寺（市）校语\",\"quote_source\":\"Z2\",\"reading\":\"唯一直接方位是小市在孝义里东。孝义里在御道北，而东于一个里域并不自动给出小市的御道路侧、同纬或门距。\",\"road_side_explicit\":false,\"road_side_inherited\":false,\"source_region\":\"R09\",\"sources\":[\"Z2\",\"F2\"],\"temporal_note\":null,\"textual_layer\":\"古籍正文短引（按所标电子整理本，夹注分离）\",\"title\":\"小市在孝义里东，路侧不能照搬\",\"variants\":[{\"reading\":\"底本文字小寺，范据吴琯、汉魏、元河南志校为小市。\",\"source\":\"F2\"}]}"
    },
    {
      "path": "research/dual-b6/southeast-outer.json",
      "pointer": "/evidence/16",
      "sha256": "0f55556ef5307a5c4e42fccaac91863024e2a8faf64add3905c10bb544854448",
      "value_sha256": "2ebf0f845ad7d9d4b74f94cd6236a3d55a8a078daf54fb041640852d313b03bb",
      "locator": "research/dual-b6/southeast-outer.json/evidence/16",
      "url": null,
      "excerpt": "{\"constraints\":[{\"basis\":\"adopted_punctuation\",\"object\":\"li_xiaoyi\",\"relation\":\"east_of\",\"subject\":\"li_zhihuo\"},{\"basis\":\"adopted_contextual_reference\",\"object\":\"market_small\",\"relation\":\"north_of\",\"subject\":\"li_zhihuo\"},{\"basis\":\"inherited_residence_membership\",\"object\":\"li_zhihuo\",\"relation\":\"within\",\"subject\":\"v2_guijue\"}],\"drawing\":\"继续保留殖货里／小市北的群组阅读锚点。关系板画里与市、宅与里两级关系，路侧不从小市或孝义里继续传递。\",\"ellipsis_is_editorial\":false,\"entities\":[\"li_zhihuo\",\"li_xiaoyi\",\"market_small\",\"v2_guijue\",\"road_qingyang\"],\"geographic_coordinates\":null,\"id\":\"EO17\",\"limit\":\"断读和市的回指是上下文解释；不能以示意排列决定殖货里与孝义里边界，或决定归觉宅距市的准确方位、街址。\",\"new_independent_anchor_allowed\":false,\"non_entailments\":[\"归觉寺具有独立街址\",\"殖货里已知在清阳御道北\",\"东市必须另增为第二市场\"],\"quote\":\"孝義里東市北殖貨里。里有太常民劉胡兄弟四人，以屠為業。\",\"quote_is_excerpt\":true,\"quote_locator\":\"卷二末·殖货里刘胡兄弟段；Z2 p0139a05；F2同段\",\"quote_source\":\"Z2\",\"reading\":\"本批沿用孝义里东、市北〔有〕殖货里的断读，把市接前文小市。刘胡兄弟宅只落实里属；不为东市再建一个独立市场，也不把群组标签变成宅院点。\",\"reading_status\":\"selected_punctuation_with_context\",\"road_side_inherited\":false,\"source_region\":\"R09\",\"sources\":[\"Z2\",\"F2\"],\"temporal_note\":null,\"textual_layer\":\"古籍正文短引（按所标电子整理本，夹注分离）\",\"title\":\"殖货里：里东、市北与归觉的群组位置\",\"variants\":[{\"reading\":\"正文殖货；周列太平广记、大典、逸史作植货。\",\"source\":\"Z2\"},{\"reading\":\"正文殖货；范列吴琯、汉魏及太平广记作植。\",\"source\":\"F2\"}]}"
    },
