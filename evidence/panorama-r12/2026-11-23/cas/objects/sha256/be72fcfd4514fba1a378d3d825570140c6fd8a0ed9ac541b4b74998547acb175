      "value_sha256": "d7f9cfbbc80545f35867f5f03f86d1ac50453983ed6bedce7b1235b35bd3a2d3",
      "locator": "research/dual-b6/southeast-outer.json/evidence/1",
      "url": null,
      "excerpt": "{\"constraints\":[{\"basis\":\"direct\",\"distance\":1,\"distance_endpoints\":null,\"object\":\"gate_dongyang\",\"relation\":\"outside_gate\",\"subject\":\"v2_zhuangyan\",\"unit\":\"里\"},{\"basis\":\"direct\",\"object\":\"road_dongyang\",\"relation\":\"north_of\",\"subject\":\"v2_zhuangyan\"},{\"basis\":\"direct\",\"object\":\"li_dongan\",\"relation\":\"within\",\"subject\":\"v2_zhuangyan\"}],\"drawing\":\"主图沿原锚点使用空心无塔寺符；一里只作原文里程标签，东安里用里属关系牌而不补坊墙。\",\"ellipsis_is_editorial\":false,\"entities\":[\"v2_zhuangyan\",\"gate_dongyang\",\"road_dongyang\",\"li_dongan\"],\"geographic_coordinates\":null,\"id\":\"EO02\",\"limit\":\"不把一里换算成米或现址距离；不由庄严与秦太上君分别一里、二里而断言寺间恰好一里或两寺同纬。\",\"non_entailments\":[\"庄严与秦太上君寺间恰一里\",\"两寺处于同一直线或同纬\",\"庄严寺始建于某个确定年份\"],\"quote\":\"莊嚴寺，在東陽門外一里御道北，所謂東安里也。\",\"quote_is_excerpt\":true,\"quote_locator\":\"卷二·庄严寺首句；Z2 / CBETA B12n0077 p0111a10\",\"quote_source\":\"Z2\",\"reading\":\"庄严寺具有东阳门外一里、御道北和东安里里属三项文本约束；没有建寺年月。\",\"source_region\":\"R09\",\"sources\":[\"Z2\",\"F2\"],\"temporal_note\":\"沿用undated；空心表示截至528年前的寺院状态未获限定，不等于寺必晚出。\",\"textual_layer\":\"古籍正文短引（按所标电子整理本，夹注分离）\",\"title\":\"庄严：一里、道北与东安里\",\"variants\":[]}"
    },
    {
      "path": "research/dual-b6/southeast-outer.json",
      "pointer": "/evidence/3",
      "sha256": "0f55556ef5307a5c4e42fccaac91863024e2a8faf64add3905c10bb544854448",
      "value_sha256": "03ca3a3b849adbc48b8e57eef6f502788829bc0e7c14d45496f7e222769be659",
      "locator": "research/dual-b6/southeast-outer.json/evidence/3",
      "url": null,
      "excerpt": "{\"constraints\":[{\"basis\":\"direct\",\"distance\":2,\"distance_endpoints\":null,\"object\":\"gate_dongyang\",\"relation\":\"outside_gate\",\"subject\":\"v2_qintaishangjun\",\"unit\":\"里\"},{\"basis\":\"direct\",\"object\":\"road_dongyang\",\"relation\":\"north_of\",\"subject\":\"v2_qintaishangjun\"},{\"basis\":\"direct\",\"object\":\"li_huiwen\",\"relation\":\"within\",\"subject\":\"v2_qintaishangjun\"}],\"drawing\":\"沿原点使用无塔寺符，里程和里属分开登记；不把晖文里内四宅排成确定院落次序。\",\"ellipsis_is_editorial\":true,\"entities\":[\"v2_qintaishangjun\",\"gate_dongyang\",\"road_dongyang\",\"li_huiwen\",\"v3_qintaigong_w\",\"v3_qintaigong_e\"],\"geographic_coordinates\":null,\"id\":\"EO04\",\"identity_policy\":\"mother_memorial_record_not_merged_with_father_memorial_pair\",\"limit\":\"寺名或母亲死亡时间不能当作寺院完工日期；二里与外字有传本差异。未据本批新增精确营建年。\",\"quote\":\"秦太上君寺，胡太后所立也。……為母追福，因以名焉。……在東陽門外二里御道北，所謂暉文里。\",\"quote_is_excerpt\":true,\"quote_locator\":\"卷二·秦太上君寺首段及追福子注；Z2 p0112a02、p0112a06、p0112a11\",\"quote_source\":\"Z2\",\"reading\":\"这是东阳门外二里、道北、晖文里的秦太上君寺，为母追福。君与公不能因字近而合并；城南为父的两寺继续用既有独立记录。\",\"source_region\":\"R09\",\"sources\":[\"Z2\",\"F2\"],\"temporal_note\":\"沿用attested_by_528及胡太后立寺背景；本批不把其母卒年、追赠或寺名直接等同于建寺完工年。\",\"textual_layer\":\"古籍正文短引（按所标电子整理本，夹注分离）\",\"title\":\"秦太上君寺：晖文里与为母追福\",\"variants\":[{\"reading\":\"门外之外字据河南志及吴集证补入。\",\"source\":\"Z2\"},{\"reading\":\"同样补外；校语记吴琯、汉魏本无二里。\",\"source\":\"F2\"}]}"
    },
    {
      "path": "research/dual-b6/southeast-outer.json",
      "pointer": "/evidence/5",
      "sha256": "0f55556ef5307a5c4e42fccaac91863024e2a8faf64add3905c10bb544854448",
      "value_sha256": "c6eb1eb061b2362bb1f427c5ba6db327d28507b0f7fe3736f2b95162da76c02b",
      "locator": "research/dual-b6/southeast-outer.json/evidence/5",
      "url": null,
      "excerpt": "{\"adopted_roadside\":\"south\",\"claim_status\":\"selected_editorial_reading\",\"constraints\":[{\"basis\":\"direct\",\"object\":\"gate_dongyang\",\"relation\":\"outside_gate\",\"subject\":\"v2_zhengshi\"},{\"basis\":\"adopted_Z2_editorial_reading\",\"claim_status\":\"selected_not_consensus\",\"object\":\"road_dongyang\",\"relation\":\"south_of\",\"subject\":\"v2_zhengshi\"},{\"basis\":\"direct\",\"object\":\"li_jingyi\",\"relation\":\"within\",\"subject\":\"v2_zhengshi\"}],\"drawing\":\"保留原道南锚点；关系板标南†并列范正文西，不把传文御道西另画成一条不存在的新道路。\",\"ellipsis_is_editorial\":false,\"entities\":[\"v2_zhengshi\",\"gate_dongyang\",\"road_dongyang\",\"li_jingyi\"],\"fan_main_text_roadside\":\"west\",\"foundation_reign\":\"正始\",\"foundation_year_range_ce\":[504,508],\"geographic_coordinates\":null,\"id\":\"EO06\",\"limit\":\"门外未载里数；选读不等于地理定论。若以后采用范西，须另行讨论御道参照，不直接旋转或挪动现有锚点。\",\"quote\":\"正始寺，百官等所立也。正始中立，因以為名。在東陽門外御道南，所謂敬義里也。\",\"quote_is_excerpt\":true,\"quote_locator\":\"卷二·正始寺首段；Z2 p0116a12—14；F2同条御道西校语\",\"quote_source\":\"Z2\",\"reading\":\"正始年间立寺提供早于528的寺院时段。位置上周据所见传文改南，范电子正文保留西并列南字异本；本批沿既有主图采用周校南，不能称两本共同证明道南。\",\"source_region\":\"R09\",\"sources\":[\"Z2\",\"F2\"],\"temporal_note\":\"正始年号504—508；立寺时段与捐款、后人刊碑分开，不能精确为504年建成。\",\"textual_layer\":\"古籍正文短引（按所标电子整理本，夹注分离）\",\"title\":\"正始寺路侧是周南、范西的选择\",\"variants\":[{\"reading\":\"正文作御道南；校记原作西，依永乐大典所引及逸史本改南。\",\"source\":\"Z2\"},{\"reading\":\"正文保留御道西；校语列吴琯、汉魏、真意堂本作南，又记元河南志作西。\",\"source\":\"F2\"}]}"
    },
