    "blocking_defects_found": [],
    "tree_plan": "Builds native Git tree identities, preserves the accepted base tree when grafting the new archive, rejects an occupied final archive directory, and requires uploaded root tree identity to match.",
    "readback": "Checks exact parent/root tree and archive path set; independently reads all unique blob bytes and checks each path against size, SHA-256 and Git blob SHA-1; reconciles internal inventory, scope, artifact wrapper members and sensitive scan.",
    "inventory_scope": "Internal inventory deliberately omits archive-inventory.json, archive-scope.json and archive-sensitive-scan.json to avoid self-reference; the external frozen upload manifest must bind all three plus every payload file.",
    "independent_additional_check": "Compare the complete path/mode/type/object map outside the archive prefix between production and archive commits, and require the archive prefix to be absent in the parent. This avoids relying only on diff name output or rename configuration.",
    "current_preupload_snapshot": "preupload-payload-005-upload-manifest.json: 650 unique canonical paths, no duplicate paths or file/directory collisions. This snapshot is not treated as the final manifest."
  },
