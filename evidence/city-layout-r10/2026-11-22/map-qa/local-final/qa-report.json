  "visual_review": [
    {
      "page": 1,
      "png": "page-01.png",
      "reviewed": true,
      "result": "pass",
      "notes": "来源骨架与十一片区目录明确分框；候选淡蓝灰、原段绿色、近现代参照默认不见；北箭与图签无冲突。"
    },
    {
      "page": 2,
      "png": "page-02.png",
      "reviewed": true,
      "result": "pass",
      "notes": "北门东西序、东北关系分量和两组门外道路分别可读；寺前活动场与无序宅第不生成院墙。"
    },
    {
      "page": 3,
      "png": "page-03.png",
      "reviewed": true,
      "result": "pass",
      "notes": "四门南北序独立成组，冲觉及五层塔分期可读；阊阖道外局部寺序箭线绕避不相关标签。"
    },
    {
      "page": 4,
      "png": "page-04.png",
      "reviewed": true,
      "result": "pass",
      "notes": "文献道南白马与独立发掘框分列；中央十字符号、六街分录、未核南续及22/7.5/4.6米归属可读。"
    },
    {
      "page": 5,
      "png": "page-05.png",
      "reviewed": true,
      "result": "pass",
      "notes": "西游园与华林园按独立约束组排；灵芝三侧殿、台海山构件和柰林碑堂补充均完整可见。"
    },
    {
      "page": 6,
      "png": "page-06.png",
      "reviewed": true,
      "result": "pass",
      "notes": "司马三带及三个道路宽度分对象；金墉成员与景阳山方向分框；上下页无漏裁。"
    },
    {
      "page": 7,
      "png": "page-07.png",
      "reviewed": true,
      "result": "pass",
      "notes": "建春三桥的对象、方向与527年事件分别保留；北渠迹、南渠解释、门下暗渠和七里涧分层。"
    },
    {
      "page": 8,
      "png": "page-08.png",
      "reviewed": true,
      "result": "pass",
      "notes": "四向八里采用共同参照并保留同侧无序；寿丘范围语未画成闭合测界；宅园构件分层。"
    },
    {
      "page": 9,
      "png": "page-09.png",
      "reviewed": true,
      "result": "pass",
      "notes": "西阳门内路侧、旧宅官署东序、补南永康与季节池分别可读；旧址识别不转成同期水岸。"
    },
    {
      "page": 10,
      "png": "page-10.png",
      "reviewed": true,
      "result": "pass",
      "notes": "宫前寺邻、两列官署南序和候选水路分四窗；较长独立竖窗保持完整链条，未作镜像。"
    },
    {
      "page": 11,
      "png": "page-11.png",
      "reviewed": true,
      "result": "pass",
      "notes": "东墙门序改为独立高列，图签不再相叠；道北二署、道南昭仪及回指条件均有完整说明。"
    },
    {
      "page": 12,
      "png": "page-12.png",
      "reviewed": true,
      "result": "pass",
      "notes": "东阳与青阳门外寺里、孝义小市和宅改寺时序分开；校读和晚出时间以独立类型表达。"
    },
    {
      "page": 13,
      "png": "page-13.png",
      "reviewed": true,
      "result": "pass",
      "notes": "城南礼制东西参照与独立残渠分框；景明三池数量、始造未定层和大统里属分别保留。"
    },
    {
      "page": 14,
      "png": "page-14.png",
      "reviewed": true,
      "result": "pass",
      "notes": "双女寺、学堂、报德、津阳与劝学分成五组；两条时间线独立；所有新增说明与判断页脚未裁切。"
    },
    {
      "page": 15,
      "png": "page-15.png",
      "reviewed": true,
      "result": "pass",
      "notes": "永桥与两岸标志不生成测桥长；四馆四里只是路侧分组；只有前两制度组标明三年条件。"
    },
    {
      "page": 16,
      "png": "page-16.png",
      "reviewed": true,
      "result": "pass",
      "notes": "四类依据颜色、图面语义、六类空间边界和96项判断回查路径均可读，来源提交与页码分开。"
    }
  ],
