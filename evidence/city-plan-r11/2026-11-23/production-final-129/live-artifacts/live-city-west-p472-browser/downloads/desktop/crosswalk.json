  "records": [
    {
      "id": "WR01",
      "p1_key": "B5:WR01",
      "period_label": "西墙门序",
      "map_reading": "将四座门按文字由南至北排列。地理图仅标其中有06a参照的西明、西阳。"
    },
    {
      "id": "WR02",
      "p1_key": "B5:WR02",
      "period_label": "卷一永宁寺条",
      "map_reading": "以宫城阊阖门作同名辨析。“南一里”属于永宁寺与宫门。"
    },
    {
      "id": "WR03",
      "p1_key": "B5:WR03",
      "period_label": "寺至迟528年有据",
      "map_reading": "融觉可列在城西阊阖门外御道南。门、御道与寺均保留空定位。"
    },
    {
      "id": "WR04",
      "p1_key": "B5:WR04",
      "period_label": "寺与塔分期",
      "map_reading": "五层属塔。一里与三里的异文并列，寺界、塔高和完工年均待考。"
    },
    {
      "id": "WR05",
      "p1_key": "B5:WR05",
      "period_label": "大觉设寺年未定",
      "map_reading": "标示大觉西于融觉，保留“一里许”与未明的两端。"
    },
    {
      "id": "WR06",
      "p1_key": "B5:WR06",
      "period_label": "两寺时期分别登记",
      "map_reading": "融觉和永明都在大觉以东。两条关系各自作图，二者的东西先后留空。"
    },
    {
      "id": "WR07",
      "p1_key": "B5:WR07",
      "period_label": "宣武帝所立",
      "map_reading": "保留永明安置外来僧人的用途。千余间、三千余人只入文字。"
    },
    {
      "id": "WR08",
      "p1_key": "B5:WR08",
      "period_label": "宅改寺年未定",
      "map_reading": "保留〔立〕与节略号。周校“懷”、范留“環”，堂内七佛按造像读取。"
    },
    {
      "id": "WR09",
      "p1_key": "B5:WR09",
      "period_label": "永熙年间 532—534",
      "map_reading": "永熙砖塔列入后出构件。寺的初设年与塔层数分别留空。"
    },
    {
      "id": "WR10",
      "p1_key": "B5:WR10",
      "period_label": "眺望所述年份未明",
      "map_reading": "四向所见入景观说明。旗亭的门亭解释归于周注，观测点未定。"
    },
    {
      "id": "WR11",
      "p1_key": "B5:WR11",
      "period_label": "宝光设寺年未定",
      "map_reading": "宝光可列在西阳门外御道北。门上的来源图符只指门。"
    },
    {
      "id": "WR12",
      "p1_key": "B5:WR12",
      "period_label": "塔的年代未定",
      "map_reading": "三层、石基分别登记。上部材料与基座平面留空。"
    },
    {
      "id": "WR13",
      "p1_key": "B5:WR13",
      "period_label": "人物发言与普泰末事件",
      "map_reading": "晋寺同址说署赵逸。普泰末的毁损限于寺门，单列在盛时窗口之后。"
    },
    {
      "id": "WR14",
      "p1_key": "B5:WR14",
      "period_label": "法云与宝光均年未定",
      "map_reading": "法云在宝光西，隔墙并门。只画相对关系，法云自身路侧未明。"
    },
    {
      "id": "WR15",
      "p1_key": "B5:WR15",
      "period_label": "法云设寺年未定",
      "map_reading": "祗洹用字差异和胡饰记述进证据卡。洛阳实体数与殿房足迹均不增加。"
    },
    {
      "id": "WR16",
      "p1_key": "B5:WR16",
      "period_label": "宅第营建年未载",
      "map_reading": "临淮王彧宅在法云寺北。共墙、朝向和宅园范围留空。"
    },
    {
      "id": "WR17",
      "p1_key": "B5:WR17",
      "period_label": "冲觉寺至迟528年有据",
      "map_reading": "沿用沖覺寺／冲觉寺的实体。原宅改寺，文献记西明门外一里御道北。"
    },
    {
      "id": "WR18",
      "p1_key": "B5:WR18",
      "period_label": "525年复政后，完工年未载",
      "map_reading": "五层追福塔单列为工程。528年以前是否竣工仍待证。"
    },
    {
      "id": "WR19",
      "p1_key": "B5:WR19",
      "period_label": "盛时为城阳王徽宅",
      "map_reading": "西阳门外一里道南的地点用“城阳王徽宅〔后宣忠〕”显示。"
    },
    {
      "id": "WR20",
      "p1_key": "B5:WR20",
      "period_label": "529年北海败散后舍宅",
      "map_reading": "分列原宅、战时许愿、败散后兑现。以后的寺院用途不前推。"
    },
    {
      "id": "WR21",
      "p1_key": "B5:WR21",
      "period_label": "王典御寺至迟528年有据",
      "map_reading": "东向所指是后来名为宣忠的地点。王典御与门前三层塔分别记时。"
    },
    {
      "id": "WR22",
      "p1_key": "B5:WR22",
      "period_label": "宅与安置佛徒未独立定年",
      "map_reading": "宜年里在永明西。景皓宅、胡元吉宅并列为里内成员；半宅安置归景皓。"
    },
    {
      "id": "WR23",
      "p1_key": "B5:WR23",
      "period_label": "白马西阳条年未定",
      "map_reading": "保留门外三里道南及范校引书异文。汉明帝建寺传统另列，沿用空定位。"
    },
    {
      "id": "WR24",
      "p1_key": "B5:WR24",
      "period_label": "两条白马均年未定",
      "map_reading": "卷四西阳条和卷五瀍涧条保留两个条目，同一性待考。两条均不借现代寺址。"
    }
  ],
