      ],
      "changhe_reading_basis": "contextual_interpretation"
    },
    {
      "id": "LG10",
      "source_region": "R11",
      "title": "萧正德：来降、处馆、筑宅与纪年异记分层",
      "entities": [
        "guan_jinling",
        "li_guizheng",
        "house_xiaozhengde",
        "v3_guizheng"
      ],
      "quote": "正光四年中，蕭衍子西豐侯蕭正德來降，處金陵館，為築宅歸正里。",
      "quote_source": "Z3",
      "quote_locator": "卷三·四夷馆里段萧正德；CBETA B12n0077 p0161a06—08；另参同卷正觉寺水厄段周注（电子本文57、64行）",
      "quote_is_excerpt": true,
      "ellipsis_is_editorial": false,
      "textual_layer": "古籍正文短引（按所标电子整理本，夹注分离）",
      "reading": "卷三此处周、范正文均记正光四年（523）来降并处金陵馆、筑宅归正里。周在同卷正觉寺水厄段的注释又转引《魏书》作正光三年（522），并讨论另一史载的年代问题；本批没有独立核史传，不能把注引当作另经核验的来源家族。",
      "drawing": "流程板依次写来降→金陵馆→归正里筑宅，正文523与周注转引522并列为纪年异记；萧正德宅保持E03旁注，不另分配宅址。",
      "limit": "来降纪年不等于筑宅完工年，更不等于归正寺成立年；不能把一般三年授宅句强套此人再计算出一个确定宅寺年代。",
      "sources": [
        "Z3",
        "F3"
      ],
      "variants": [
        {
          "source": "Z3",
          "reading": "四馆段正文正光四年；同卷正觉寺条周注转引魏书为正光三年，属于校注引史层。"
        },
        {
          "source": "F3",
          "reading": "四馆段正文同为正光四年，没有在本句改成三年。"
        }
      ],
      "constraints": [
