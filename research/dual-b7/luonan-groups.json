    {
      "id": "LG06",
      "source_region": "R11",
      "title": "雁臣秋来春去：季节性入侍不同于永久落户",
      "entities": [
        "guan_yanran",
        "li_guide"
      ],
      "quote": "北夷酋長遣子入侍者，常秋來春去，避中國之熱，時人謂之雁臣。",
      "quote_source": "Z3",
      "quote_locator": "卷三·北夷来朝段末雁臣语；Z3电子本文67行，F3第34行",
      "quote_is_excerpt": true,
      "ellipsis_is_editorial": false,
      "textual_layer": "古籍正文短引（按所标电子整理本，夹注分离）",
      "reading": "这一句限定对象为酋长遣子入侍者，叙述常见的秋来春去及其理由。它说明同段含有往返而非只进不出的过程，但没有重写每位入侍者具体住哪一馆、在哪一里领宅。",
      "drawing": "在北来流程旁用秋来／春去的季节注记，不画全年固定住址，不给每人分宅，也不把循环箭头用作城内送迎路线。",
      "limit": "常字不是每人每年都如此；未给月份、日数、往返人数或路径。不能把季节性入侍、一般三年授宅与个案待遇合成一个无例外的自动流程。",
      "sources": [
        "Z3",
        "F3"
      ],
      "variants": [
        {
          "source": "F3",
          "reading": "正文作鴈臣，与周本雁臣为字形差异。"
        }
      ],
      "constraints": [],
      "temporal_note": "季节模式无独立年度与精确日期；不据此为馆里增加始建、停用或拆迁年。",
      "geographic_coordinates": null,
      "process_subject_literal": "北夷酋長遣子入侍者",
      "seasonal_pattern": {
        "arrival": "秋",
        "departure": "春",
