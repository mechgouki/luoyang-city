      "source_region": "R11",
      "title": "葱岭至大秦属于域外往来叙述，不落入洛阳街址",
      "entities": [
        "guan_yanzi",
        "li_muyi"
      ],
      "quote": "自葱嶺已西，至於大秦，百國千城，莫不款附。商胡販客，日奔塞下。",
      "quote_source": "Z3",
      "quote_locator": "卷三·西来附者及商胡贩客段；Z3电子本文68行，F3第34行",
      "quote_is_excerpt": true,
      "ellipsis_is_editorial": false,
      "textual_layer": "古籍正文短引（按所标电子整理本，夹注分离）",
      "reading": "葱岭、大秦等在此构成域外来源与远方往来的叙述范围，不是四馆群内的新地点。百国千城与日奔塞下表现往来广、频，并未给出可量测的城市数量、日流量或逐段旅程。",
      "drawing": "以域外来源文字说明连接崦嵫—慕义流程；不把葱岭、大秦、塞下增为洛阳点位，不画从每个远国进入各馆的确定通行线。",
      "limit": "也不能以金陵、燕然、扶桑、崦嵫的名称来源作为洛阳馆舍经纬度。本文的政治归附话语与实际迁居、商旅活动须分别阅读，不能假定所有商客最终都领宅。",
      "sources": [
        "Z3",
        "F3"
      ],
      "variants": [
        {
          "source": "Z3",
          "reading": "周据异本将欢校作款，采用款附。"
        },
        {
          "source": "F3",
          "reading": "正文保留欢附，校语列异本欵；不能把这种文字差异变成不同的来客路线。"
        }
      ],
      "constraints": [],
      "temporal_note": null,
      "geographic_coordinates": null,
      "external_place_names": [
        "葱岭",
        "大秦"
      ],
      "external_names_are_luoyang_sites": false,
      "new_local_entity_ids": [],
