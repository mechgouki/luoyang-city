    {
      "id": "camlab-digital-luoyang",
      "title": "Harvard FAS CAMLab: Digital Luoyang / 数字洛阳",
      "source_type": "institutional_digital_reconstruction_and_art_installation",
      "primary_urls": [
        "https://camlab.fas.harvard.edu/project/digital-luoyang/",
        "https://camlab.fas.harvard.edu/exhibition/digital-luoyang/"
      ],
      "attribution": {
        "institution": "Harvard FAS CAMLab",
        "individual_architectural_model_author": null,
        "author_caveat": "项目官方确认与建筑史家及考古学家合作；所读网页未将某位个人明确署为永宁寺模型设计者。2022 官网素材与 2025 展览是项目不同阶段，不计成两个独立学术方案。"
      },
      "date_evidence": "项目图 URL 为 2022/09；展览页写 2025-06-05 起在汉魏洛阳故城遗址博物馆。URL 日期仅为上传路径，非设计完成日。",
      "scale": {
        "model_scale": null,
        "historical_height_verified": false,
        "caveat": "官网图无比例尺；不从效果图量出真实高度。"
      },
      "viewed_files": [
        "camlab-cover.jpg",
        "camlab-dl1.jpg",
        "camlab-dl8.jpg",
        "camlab-dl6.jpg",
        "camlab-earth-contact.jpg",
        "camlab-earth-1-contact.jpg",
