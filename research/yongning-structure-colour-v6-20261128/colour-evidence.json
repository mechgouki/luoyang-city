  "items": [
    {
      "id": "C01",
      "object": "塔门扉",
      "grade": "A-T",
      "sources": [
        "T1",
        "T2",
        "T3"
      ],
      "original_anchor": "户皆朱漆／并皆朱漆",
      "finding": "朱红门可靠。",
      "draw_allowed": "朱红门扉。",
      "not_established": [
        "精确RGB",
        "朱砂配方",
        "所有构件同一红色"
      ]
    },
    {
      "id": "C02",
      "object": "塔窗",
      "grade": "B",
      "sources": [
        "T1",
        "T2",
        "T3"
      ],
      "original_anchor": "面有三户六窗，并皆朱漆／户皆朱漆",
      "finding": "并本支持门窗同朱；户本只明确门。",
      "draw_allowed": "红窗构可用并注明版本条件。",
      "not_established": [
        "唯一无争议读法",
        "把洞口阴影称作黑漆",
        "玻璃窗"
      ]
    },
    {
      "id": "C03",
      "object": "初层前檐墙外皮",
      "grade": "A-A",
      "sources": [
        "A1"
      ],
      "original_anchor": null,
      "finding": "初层外墙记朱色，内侧彩画；地面白灰。",
      "draw_allowed": "外墙以朱红主导。",
      "not_established": [
        "九层全部涂朱",
        "初层外墙主体已证白色",
        "朱色必为HgS"
      ]
    },
    {
      "id": "C04",
      "object": "塔上层墙",
      "grade": "U",
      "sources": [
        "T1",
        "A1"
      ],
      "original_anchor": null,
      "finding": "本轮未取得上层墙红白分布直接证据。",
      "draw_allowed": "红或浅色填充都明确标作复原假设。",
      "not_established": [
        "僧房粉壁等于塔上层粉壁",
        "九层全朱定论",
        "上层全白定论"
      ]
    },
    {
      "id": "C05",
      "object": "塔柱、梁、斗栱",
      "grade": "C",
      "sources": [
        "T1"
      ],
      "original_anchor": "绣柱金铺",
      "finding": "华美装饰可知；逐件色序不能确定。",
      "draw_allowed": "局部彩绘；全红明柱属于设计推定。",
      "not_established": [
        "全金斗栱",
        "精确彩画纹样",
        "以法隆寺现存风化木色作永宁寺原色"
      ]
    },
    {
      "id": "C06",
      "object": "门上钉/铃、环与铺首",
      "grade": "A-T/B",
      "sources": [
        "T1",
        "T2",
        "T3"
      ],
      "original_anchor": "五行金铃／五行金钉；金环铺首",
      "finding": "金属门饰有文本，钉与铃有异文。",
      "draw_allowed": "少量暖色金属饰件；说明形制版本。",
      "not_established": [
        "纯金实心",
        "铜胎鎏金已证",
        "包金或贴金已证",
        "据金色计算黄金用量"
      ]
    },
    {
      "id": "C07",
      "object": "塔刹、宝瓶、盘与铎",
      "grade": "A-T",
      "sources": [
        "T1"
      ],
      "original_anchor": "金刹；金宝瓶；承露金盘；金铎；更铸新瓶",
      "finding": "都在塔段；新瓶有再铸记录。",
      "draw_allowed": "金色金属观感是文字导向的视觉解释。",
      "not_established": [
        "所有构件纯金",
        "铎必为黄金",
        "统一鎏金技术",
        "殿或门楼同有塔刹"
      ]
    },
    {
      "id": "C08",
      "object": "牵刹铁锁",
      "grade": "A-T",
      "sources": [
        "T1"
      ],
      "original_anchor": "铁鏁四道，引刹向浮图四角",
      "finding": "铁质、四道与牵向塔角关系明确。",
      "draw_allowed": "暗色金属链、受光高光。",
      "not_established": [
        "金链",
        "精确尺寸和合金",
        "初建即重锈色"
      ]
    },
    {
      "id": "C09",
      "object": "瓦屋面",
      "grade": "A-A/B",
      "sources": [
        "A2"
      ],
      "original_anchor": null,
      "finding": "永宁寺瓦样本具青灰、黑灰等色调与磨研光泽。",
      "draw_allowed": "灰、青灰至近黑，允许柔和反光；塔层分配属外推。",
      "not_established": [
        "黄绿蓝琉璃瓦屋面已证",
        "磨研或陶衣就是玻璃釉",
        "全部瓦相同颜色光泽",
        "样本全部来自塔"
      ]
    },
    {
      "id": "C10",
      "object": "僧房楼观",
      "grade": "A-T",
      "sources": [
        "T1"
      ],
      "original_anchor": "僧房楼观，一千余间，雕梁粉壁，青璅绮疏",
      "finding": "粉壁、青琐和绮疏紧接僧房楼观。",
      "draw_allowed": "相关附属建筑浅色抹面和局部青色装饰。",
      "not_established": [
        "塔上层必须白墙",
        "绮疏为色名",
        "青琐即青琉璃瓦"
      ]
    },
    {
      "id": "C11",
      "object": "南门楼及东西门楼装饰",
      "grade": "A-T",
      "sources": [
        "T1"
      ],
      "original_anchor": "图以云气，画彩仙灵，列钱青璅；饰以金银，加之珠玉",
      "finding": "前组词属门楼；后组词紧接门洞力士狮子。",
      "draw_allowed": "门楼局部彩绘、青色门饰、守护形象金属装饰。",
      "not_established": [
        "全塔同样彩画",
        "整塔金银包覆",
        "北门同样屋顶和彩画"
      ]
    },
    {
      "id": "C12",
      "object": "寺院西墙",
      "grade": "A-A",
      "sources": [
        "A3"
      ],
      "original_anchor": null,
      "finding": "西院墙观察到白土面和局部红彩。",
      "draw_allowed": "院墙可有白抹面与红色区段；完整图案仍未知。",
      "not_established": [
        "塔上层同样色制",
        "全寺四墙同图"
      ]
    },
    {
      "id": "C13",
      "object": "佛殿内供像",
      "grade": "A-T",
      "sources": [
        "T1"
      ],
      "original_anchor": "浮图北有佛殿一所……中有丈八金像……",
      "finding": "金玉织绣在此描述殿中供像。",
      "draw_allowed": "只约束像的材料/装饰提示。",
      "not_established": [
        "殿屋顶贴金",
        "塔外墙金色",
        "纯度和工艺已定"
      ]
    },
    {
      "id": "C14",
      "object": "飞甍",
      "grade": "X",
      "sources": [
        "T2"
      ],
      "original_anchor": null,
      "finding": "永宁寺原文段本轮未见；周本所见在金墉城注文引诗。",
      "draw_allowed": "不能用于本塔颜色判断。",
      "not_established": [
        "永宁寺塔琉璃瓦文献证据",
        "该词规定屋面色"
      ]
    }
  ],
  "limits": [
    "不从朱色推出朱砂HgS，不从金推出纯金或鎏金。",
    "没有塔建筑涂层的化学、光谱与校准测色数据；不提供历史实测RGB或颜料配方。",
    "泥塑彩绘/贴金只约束泥塑，不能直接推定建筑涂层。",
    "塔周风铎残片不能因同一出土清单另列铁制佛具而被判定为铁铎。",
    "色彩图与结构材料、自重假定必须分开。"
  ]
}
